NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-another-long-random-secret

# Comma-separated browser origins allowed to call the backend.
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# IA — pool de clés Gemini
# Utilisé UNIQUEMENT par le backend (backend/lib/naila.ts).
# Ne jamais préfixer par VITE_ : toute variable VITE_ est injectée dans
# le bundle public et devient lisible par n'importe quel visiteur.
#
# GEMINI_API_KEYS : plusieurs clés séparées par des virgules. Lorsqu'une clé
# atteint son quota ou tombe en surcharge, l'appel bascule sur la suivante
# sans interrompre la requête. Laisse vide pour n'utiliser que GEMINI_API_KEY.
GEMINI_API_KEYS=
# Clé principale, et modèle essayé en premier.
GEMINI_API_KEY=
# Doit exister sur le plus grand nombre de clés du pool, le service bascule
# ensuite sur les modèles de secours déclarés dans naila.ts.
GEMINI_MODEL_ID=gemini-3.5-flash-lite
# Délai maximum d'une tentative avant bascule sur la clé suivante (ms).
GEMINI_TIMEOUT_MS=15000
